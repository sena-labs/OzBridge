{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "ignoreDeprecations": "6.0",
    "paths": {
      "copilot-chat-toolkit": ["./packages/copilot-chat-toolkit/src/index.ts"]
    },
    "types": ["node"],
    "strict": true,
    // Dead imports and locals accumulated in src/ until CodeQL surfaced 10 of
    // them at once. `npm run lint` is this same tsc invocation and runs in CI,
    // so failing the build is a tighter loop than a static-analysis note.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", ".vscode-test"]
}
