# Source & development
.vscode/**
.vscode-test/**
.github/**
src/**
test/**
docs/**
coverage/**

# Build tooling
tsconfig.json
vitest.config.ts
esbuild.js
.gitignore
.markdownlint*

# SDK workspace package (bundled by esbuild)
packages/**

# Scaffold output (created by /init, not part of the extension)
.agents/**
.warp/**
.venv/**

# Local secrets / machine-only files
.env
.env.*

# Temporary media artifacts
media/screenshot*.*
media/file.*

# Misc
node_modules/**
*.ts
!dist/**

# Source maps (exclude after !dist re-include)
dist/**/*.map

# VSIX artifacts (avoid recursive packaging)
dist/**/*.vsix
*.vsix

# Localisation bundles must ship with the extension
!l10n/**
!package.nls*.json

# Publishing scripts (not needed by end-users)
scripts/**

# PR body scratchpad (local-only, never ships to Marketplace)
pr-body.md

test-out.txt
*.txt
