# Source & development
.vscode/**
.vscode-test/**
.github/**
src/**
test/**
docs/**
coverage/**

# Build tooling
tsconfig.json
vitest.config.ts
esbuild.js
.gitignore
.markdownlint*

# SDK workspace package (bundled by esbuild)
packages/**

# Scaffold output (created by /init, not part of the extension)
.agents/**
.warp/**
.venv/**

# Local secrets / machine-only files
.env
.env.*

# Unreferenced placeholder hero asset (only emitted by scripts/generate_media.py)
media/screenshot.svg

# Launch promo / marketing assets (not referenced by the listing README — never ship in the extension)
media/launch/**

# MCP registry manifest (repo-root metadata, not part of the extension)
server.json

# Runtime artefacts (never ship)
test-results/**
.claude/**
.remember/**

# Misc
node_modules/**

# Bundled output is the only thing we ship from dist/, but exclude
# source maps explicitly (esbuild emits `.map` alongside `.js`).
!dist/**
dist/**/*.map

# VSIX artifacts (avoid recursive packaging)
dist/**/*.vsix
*.vsix

# Localisation bundles must ship with the extension
!l10n/**
!package.nls*.json

# Publishing scripts (not needed by end-users)
scripts/**

# PR body scratchpad (local-only, never ships to Marketplace)
pr-body.md

# Local databases and dev/install scripts (install helper has hardcoded
# local paths + dev-only comments — must never ship to the Marketplace)
*.db
*.ps1

# Internal dev/agent notes — developer-only, never ship
AGENTS.md

# Internal audit / planning reports (developer-only, never ship to Marketplace).
# Pattern-based so newly-named audit docs cannot leak again. No shipped doc
# is named `OzBridge*.md` or `*Audit*.md` (README/CHANGELOG/PRIVACY/SECURITY
# /DISCLAIMER are all explicitly allow-listed names).
AUDIT_REPORT*.md
OzBridge_AUDIT_FINDINGS.md
OzBridge*.md
*Audit*.md
*audit*.md

test-out.txt
*.txt
