{
  "name": "warp-vsc-bridge",
  "displayName": "%displayName%",
  "description": "%description%",
  "l10n": "./l10n",
  "version": "0.8.0",
  "publisher": "sena-labs",
  "license": "MIT",
  "workspaces": ["packages/*"],
  "repository": {
    "type": "git",
    "url": "https://github.com/sena-labs/warp-vsc-bridge"
  },
  "bugs": {
    "url": "https://github.com/sena-labs/warp-vsc-bridge/issues"
  },
  "homepage": "https://github.com/sena-labs/warp-vsc-bridge#readme",
  "icon": "media/warp-icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Chat"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "warp-vsc-bridge.warp",
        "name": "warp",
        "fullName": "Warp Bridge",
        "description": "Run Warp Oz agents from VS Code",
        "isSticky": true,
        "commands": [
          {
            "name": "run",
            "description": "Run an Oz agent locally in the current workspace"
          },
          {
            "name": "cloud",
            "description": "Run an Oz agent in the cloud (consumes credits)"
          },
          {
            "name": "status",
            "description": "Check status of cloud agent runs"
          },
          {
            "name": "history",
            "description": "View history of past agent runs"
          },
          {
            "name": "schedule",
            "description": "Create and manage scheduled agent runs"
          },
          {
            "name": "models",
            "description": "List available AI models"
          },
          {
            "name": "mcp",
            "description": "List configured MCP servers"
          },
          {
            "name": "config",
            "description": "Show current Warp Bridge configuration"
          },
          {
            "name": "init",
            "description": "Scaffold Warp Skills and Rules for this workspace"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "warp_run_local",
        "displayName": "Run Warp Oz agent (local)",
        "toolReferenceName": "warpRunLocal",
        "modelDescription": "Runs a Warp Oz agent locally in the current VS Code workspace and returns its output. Use when the user asks to execute, refactor, test, or debug code using Warp without consuming cloud credits. Automatically injects IDE context (workspace path, active file, selection, diagnostics) unless `includeIdeContext: false` is passed.",
        "userDescription": "Let Copilot invoke Warp Oz agents locally without typing @warp.",
        "canBeReferencedInPrompt": true,
        "icon": "$(warp)",
        "tags": ["warp", "oz", "agent", "local"],
        "inputSchema": {
          "type": "object",
          "required": ["prompt"],
          "properties": {
            "prompt": {
              "type": "string",
              "description": "Natural-language instruction for the Oz agent."
            },
            "model": {
              "type": "string",
              "description": "Optional AI model override (e.g. `gpt-4o`). Defaults to `warpBridge.defaultModel`."
            },
            "profile": {
              "type": "string",
              "description": "Optional Oz agent profile name. Defaults to `warpBridge.defaultProfile`."
            },
            "skill": {
              "type": "string",
              "description": "Optional agent skill id (e.g. `5-test-agent`). If omitted the CLI picks one based on the prompt."
            },
            "includeIdeContext": {
              "type": "boolean",
              "description": "Whether to inject workspace/file/selection/diagnostics as a [CONTEXT] prefix. Defaults to true."
            }
          }
        }
      },
      {
        "name": "warp_run_cloud",
        "displayName": "Run Warp Oz agent (cloud)",
        "toolReferenceName": "warpRunCloud",
        "modelDescription": "Launches a Warp Oz agent in the cloud. CONSUMES WARP CREDITS \u2014 always ask the user for confirmation before invoking. By default waits for the run to reach a terminal status (SUCCEEDED or FAILED) and returns the final output; pass `wait: false` to return immediately with the run id, which the agent can later query via `warp_get_run`.",
        "userDescription": "Let Copilot launch cloud Warp Oz runs (with explicit confirmation to consume credits).",
        "canBeReferencedInPrompt": true,
        "icon": "$(cloud)",
        "tags": ["warp", "oz", "agent", "cloud"],
        "inputSchema": {
          "type": "object",
          "required": ["prompt"],
          "properties": {
            "prompt": {
              "type": "string",
              "description": "Natural-language instruction for the Oz cloud agent."
            },
            "model": {
              "type": "string",
              "description": "Optional AI model override. Defaults to `warpBridge.defaultModel`."
            },
            "environment": {
              "type": "string",
              "description": "Optional cloud environment name or id. Defaults to `warpBridge.defaultEnvironment`; if both are empty the extension auto-picks the first available environment."
            },
            "skill": {
              "type": "string",
              "description": "Optional agent skill id."
            },
            "includeIdeContext": {
              "type": "boolean",
              "description": "Whether to inject IDE context as a [CONTEXT] prefix. Defaults to true."
            },
            "wait": {
              "type": "boolean",
              "description": "Whether to poll the run until it reaches a terminal state. Defaults to true."
            }
          }
        }
      },
      {
        "name": "warp_get_run",
        "displayName": "Get Warp Oz run",
        "toolReferenceName": "warpGetRun",
        "modelDescription": "Fetches the status and output of a Warp Oz run by its id. Read-only; safe to invoke without confirmation. Use it after `warp_run_cloud` with `wait: false`, or when the user references a run id.",
        "userDescription": "Look up a Warp Oz run by id.",
        "canBeReferencedInPrompt": true,
        "icon": "$(search)",
        "tags": ["warp", "oz", "agent"],
        "inputSchema": {
          "type": "object",
          "required": ["runId"],
          "properties": {
            "runId": {
              "type": "string",
              "description": "Warp run identifier (as returned by `warp_run_cloud`, `warp_list_runs`, or the Warp UI)."
            }
          }
        }
      },
      {
        "name": "warp_list_runs",
        "displayName": "List Warp Oz runs",
        "toolReferenceName": "warpListRuns",
        "modelDescription": "Lists recent Warp Oz runs. Supports filters: `all` (default), `active` (QUEUED + INPROGRESS), `completed` (SUCCEEDED + FAILED), or a specific `OzRunStatus` value. Read-only.",
        "userDescription": "List recent Warp Oz runs with an optional status filter.",
        "canBeReferencedInPrompt": true,
        "icon": "$(list-unordered)",
        "tags": ["warp", "oz", "agent"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["all", "active", "completed", "QUEUED", "INPROGRESS", "SUCCEEDED", "FAILED", "UNKNOWN"],
              "description": "Filter by status. `active` = QUEUED or INPROGRESS. `completed` = SUCCEEDED or FAILED."
            },
            "limit": {
              "type": "number",
              "description": "Maximum number of runs to return after filtering."
            }
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "warpBridgeSidebar",
          "title": "Warp Bridge",
          "icon": "media/warp-icon.png"
        }
      ]
    },
    "views": {
      "warpBridgeSidebar": [
        {
          "id": "warpBridge.runsView",
          "name": "Runs & Resources",
          "icon": "media/warp-icon.png",
          "contextualTitle": "Warp Bridge"
        },
        {
          "id": "warpBridge.driveView",
          "name": "Warp Drive",
          "icon": "media/warp-icon.png",
          "contextualTitle": "Warp Bridge"
        }
      ]
    },
    "commands": [
      {
        "command": "warpBridge.tree.refresh",
        "title": "%command.tree.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "warpBridge.tree.copyId",
        "title": "%command.tree.copyId.title%",
        "icon": "$(copy)"
      },
      {
        "command": "warpBridge.tree.openInBrowser",
        "title": "%command.tree.openInBrowser.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "warpBridge.tree.showRun",
        "title": "%command.tree.showRun.title%"
      },
      {
        "command": "warpBridge.tree.pauseSchedule",
        "title": "%command.tree.pauseSchedule.title%",
        "icon": "$(debug-pause)"
      },
      {
        "command": "warpBridge.tree.unpauseSchedule",
        "title": "%command.tree.unpauseSchedule.title%",
        "icon": "$(play)"
      },
      {
        "command": "warpBridge.tree.deleteSchedule",
        "title": "%command.tree.deleteSchedule.title%",
        "icon": "$(trash)"
      },
      {
        "command": "warpBridge.handoff",
        "title": "%command.handoff.title%",
        "category": "%category.warp%",
        "icon": "$(terminal)"
      },
      {
        "command": "warpBridge.tree.handoff",
        "title": "%command.tree.handoff.title%",
        "category": "%category.warp%",
        "icon": "$(terminal)"
      },
      {
        "command": "warpBridge.mcp.start",
        "title": "%command.mcp.start.title%",
        "category": "%category.warpMcp%",
        "icon": "$(plug)"
      },
      {
        "command": "warpBridge.mcp.stop",
        "title": "%command.mcp.stop.title%",
        "category": "%category.warpMcp%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "warpBridge.mcp.status",
        "title": "%command.mcp.status.title%",
        "category": "%category.warpMcp%",
        "icon": "$(info)"
      },
      {
        "command": "warpBridge.mcp.copyEndpointUrl",
        "title": "%command.mcp.copyEndpointUrl.title%",
        "category": "%category.warpMcp%",
        "icon": "$(copy)"
      },
      {
        "command": "warpBridge.mcp.registerClient",
        "title": "%command.mcp.registerClient.title%",
        "category": "%category.warpMcp%",
        "icon": "$(add)"
      },
      {
        "command": "warpBridge.mcp.unregisterClient",
        "title": "%command.mcp.unregisterClient.title%",
        "category": "%category.warpMcp%",
        "icon": "$(close)"
      },
      {
        "command": "warpBridge.drive.refresh",
        "title": "%command.drive.refresh.title%",
        "category": "%category.warpDrive%",
        "icon": "$(refresh)"
      },
      {
        "command": "warpBridge.drive.insertIntoChat",
        "title": "%command.drive.insertIntoChat.title%",
        "category": "%category.warpDrive%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "warpBridge.drive.copyContent",
        "title": "%command.drive.copyContent.title%",
        "category": "%category.warpDrive%",
        "icon": "$(copy)"
      },
      {
        "command": "warpBridge.drive.openInEditor",
        "title": "%command.drive.openInEditor.title%",
        "category": "%category.warpDrive%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "warpBridge.skill.edit",
        "title": "%command.skill.edit.title%",
        "category": "%category.warpSkill%",
        "icon": "$(edit)"
      },
      {
        "command": "warpBridge.skill.new",
        "title": "%command.skill.new.title%",
        "category": "%category.warpSkill%",
        "icon": "$(new-file)"
      },
      {
        "command": "warpBridge.skill.saveGlobal",
        "title": "%command.skill.saveGlobal.title%",
        "category": "%category.warpSkill%",
        "icon": "$(save)"
      },
      {
        "command": "warpBridge.skill.saveWorkspace",
        "title": "%command.skill.saveWorkspace.title%",
        "category": "%category.warpSkill%",
        "icon": "$(save-as)"
      },
      {
        "command": "warpBridge.dashboard.open",
        "title": "%command.dashboard.open.title%",
        "category": "%category.warp%",
        "icon": "$(graph)"
      },
      {
        "command": "warpBridge.triageFailure",
        "title": "%command.triageFailure.title%",
        "category": "%category.warp%",
        "icon": "$(lightbulb)"
      },
      {
        "command": "warpBridge.exportDataset",
        "title": "%command.exportDataset.title%",
        "category": "%category.warp%",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "warpBridge.tree.refresh",
          "when": "view == warpBridge.runsView",
          "group": "navigation"
        },
        {
          "command": "warpBridge.drive.refresh",
          "when": "view == warpBridge.driveView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "warpBridge.tree.copyId",
          "when": "view == warpBridge.runsView && viewItem =~ /^warp(Run|Schedule|Environment|Mcp)/",
          "group": "warpGeneric@1"
        },
        {
          "command": "warpBridge.tree.openInBrowser",
          "when": "view == warpBridge.runsView && viewItem =~ /^warpRun/",
          "group": "warpGeneric@2"
        },
        {
          "command": "warpBridge.tree.pauseSchedule",
          "when": "view == warpBridge.runsView && viewItem == warpSchedule:running",
          "group": "warpSchedule@1"
        },
        {
          "command": "warpBridge.tree.unpauseSchedule",
          "when": "view == warpBridge.runsView && viewItem == warpSchedule:paused",
          "group": "warpSchedule@1"
        },
        {
          "command": "warpBridge.tree.deleteSchedule",
          "when": "view == warpBridge.runsView && viewItem =~ /^warpSchedule/",
          "group": "warpSchedule@2"
        },
        {
          "command": "warpBridge.tree.handoff",
          "when": "view == warpBridge.runsView && viewItem =~ /^warpRun/",
          "group": "warpGeneric@3"
        },
        {
          "command": "warpBridge.drive.insertIntoChat",
          "when": "view == warpBridge.driveView && viewItem =~ /^warpDrive(Prompt|Rule|Skill)$/",
          "group": "warpDrive@1"
        },
        {
          "command": "warpBridge.drive.copyContent",
          "when": "view == warpBridge.driveView && viewItem =~ /^warpDrive(Prompt|Rule|Skill)$/",
          "group": "warpDrive@2"
        },
        {
          "command": "warpBridge.drive.openInEditor",
          "when": "view == warpBridge.driveView && viewItem =~ /^warpDrive(Prompt|Rule|Skill)$/",
          "group": "warpDrive@3"
        }
      ]
    },
    "configuration": {
      "title": "Warp Bridge",
      "properties": {
        "warpBridge.ozPath": {
          "type": "string",
          "default": "oz",
          "description": "Path to the Oz CLI executable"
        },
        "warpBridge.defaultModel": {
          "type": "string",
          "default": "auto",
          "description": "Default AI model for agent runs"
        },
        "warpBridge.defaultProfile": {
          "type": "string",
          "default": "Default",
          "description": "Default Oz agent profile"
        },
        "warpBridge.defaultEnvironment": {
          "type": "string",
          "default": "",
          "description": "Default cloud environment name (empty = none)"
        },
        "warpBridge.cloudPollingIntervalMs": {
          "type": "number",
          "default": 5000,
          "description": "Initial polling interval for cloud runs (ms)"
        },
        "warpBridge.cloudPollingTimeoutMs": {
          "type": "number",
          "default": 1800000,
          "description": "Max polling duration for cloud runs (ms, default 30 min)"
        },
        "warpBridge.timeoutMs": {
          "type": "number",
          "default": 300000,
          "description": "Timeout for local agent runs (ms, default 5 min)"
        },
        "warpBridge.maxOutputChars": {
          "type": "number",
          "default": 15000,
          "description": "Max characters shown in chat before truncation"
        },
        "warpBridge.mcpEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Start an embedded MCP server at activation so Claude Code, Cursor and Codex can drive Oz."
        },
        "warpBridge.mcpPort": {
          "type": "number",
          "default": 3847,
          "description": "TCP port the MCP server listens on when enabled."
        },
        "warpBridge.mcpBindAddress": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Network interface the MCP server binds to. Keep 127.0.0.1 unless you explicitly want to expose it."
        },
        "warpBridge.mcpBearerToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional bearer token required on every MCP request. Empty string disables auth. Set via **Settings** or `settings.json`.",
          "scope": "machine-overridable"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "warpBridge.gettingStarted",
        "title": "%walkthrough.gettingStarted.title%",
        "description": "%walkthrough.gettingStarted.description%",
        "steps": [
          {
            "id": "warpBridge.gettingStarted.installCli",
            "title": "%walkthrough.step.installCli.title%",
            "description": "%walkthrough.step.installCli.description%",
            "media": {
              "markdown": "media/walkthrough/install-cli.md"
            },
            "completionEvents": [
              "onCommand:warpBridge.tree.refresh"
            ]
          },
          {
            "id": "warpBridge.gettingStarted.firstAgent",
            "title": "%walkthrough.step.firstAgent.title%",
            "description": "%walkthrough.step.firstAgent.description%",
            "media": {
              "markdown": "media/walkthrough/first-agent.md"
            },
            "completionEvents": [
              "onChatParticipant:warp-vsc-bridge.warp"
            ]
          },
          {
            "id": "warpBridge.gettingStarted.exploreViews",
            "title": "%walkthrough.step.exploreViews.title%",
            "description": "%walkthrough.step.exploreViews.description%",
            "media": {
              "markdown": "media/walkthrough/explore-views.md"
            },
            "completionEvents": [
              "onView:warpBridge.runsView"
            ]
          },
          {
            "id": "warpBridge.gettingStarted.enableMcp",
            "title": "%walkthrough.step.enableMcp.title%",
            "description": "%walkthrough.step.enableMcp.description%",
            "media": {
              "markdown": "media/walkthrough/enable-mcp.md"
            },
            "completionEvents": [
              "onSettingChanged:warpBridge.mcpEnabled",
              "onCommand:warpBridge.mcp.start"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "npx @vscode/vsce package --no-dependencies -o warp-vsc-bridge.vsix"
  },
  "dependencies": {
    "copilot-chat-toolkit": "file:./packages/copilot-chat-toolkit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.96.0",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
